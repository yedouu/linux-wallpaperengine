#!/usr/bin/env bash
# lwe — manage the linux-wallpaperengine systemd user service.
#
# Commands: install | start | stop | restart | status | enable | disable | uninstall
#
# Overridable environment:
#   LWE_BIN       path to the linux-wallpaperengine binary (default /opt/linux-wallpaperengine/linux-wallpaperengine)
#   LWE_SHARE_DIR path holding config.example.json and linux-wallpaperengine.service
#                 (default /opt/linux-wallpaperengine)
set -euo pipefail

UNIT=linux-wallpaperengine.service
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/linux-wallpaperengine"
BIN="${LWE_BIN:-/opt/linux-wallpaperengine/linux-wallpaperengine}"
SHARE_DIR="${LWE_SHARE_DIR:-/opt/linux-wallpaperengine}"
USER_UNIT_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"

cmd="${1:-status}"

need_unit() {
    if [[ ! -f "$USER_UNIT_DIR/$UNIT" ]]; then
        echo "Service not installed yet. Run: $0 install" >&2
        exit 1
    fi
}

case "$cmd" in
    install)
        mkdir -p "$USER_UNIT_DIR" "$CONFIG_DIR"
        if [[ ! -f "$CONFIG_DIR/config.json" ]]; then
            cp "$SHARE_DIR/config.example.json" "$CONFIG_DIR/config.json"
            echo "Created default config at $CONFIG_DIR/config.json — edit it, then: $0 enable"
        fi
        sed "s|ExecStart=.*|ExecStart=${BIN} --config %h/.config/linux-wallpaperengine/config.json|" \
            "$SHARE_DIR/linux-wallpaperengine.service" > "$USER_UNIT_DIR/$UNIT"
        systemctl --user daemon-reload
        echo "Installed $UNIT for user. Enable + start now: $0 enable"
        ;;
    start)
        need_unit
        systemctl --user start "$UNIT"
        ;;
    stop)
        need_unit
        systemctl --user stop "$UNIT"
        ;;
    restart)
        need_unit
        systemctl --user restart "$UNIT"
        ;;
    status)
        need_unit
        systemctl --user status "$UNIT"
        ;;
    enable)
        need_unit
        systemctl --user enable --now "$UNIT"
        ;;
    disable)
        need_unit
        systemctl --user disable --now "$UNIT"
        ;;
    uninstall)
        systemctl --user disable --now "$UNIT" 2>/dev/null || true
        systemctl --user reset-failed "$UNIT" 2>/dev/null || true
        rm -f "$USER_UNIT_DIR/$UNIT"
        systemctl --user daemon-reload
        echo "Service removed. Config (if any) left at $CONFIG_DIR/config.json"
        ;;
    *)
        echo "Usage: $0 {install|start|stop|restart|status|enable|disable|uninstall}" >&2
        exit 2
        ;;
esac
